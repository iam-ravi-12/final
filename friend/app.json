{
  "expo": {
    "name": "friend",
    "slug": "friend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "friend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "This app needs your location to show nearby SOS alerts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs background location access to send you notifications about nearby SOS alerts even when the app is closed.",
        "NSCameraUsageDescription": "This app uses the camera to capture photos and videos for your posts.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio and video for your posts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.friend"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0a2d8f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.anonymous.friend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0a2d8f",
          "sounds": [
            "./assets/sounds/notification.wav"
          ],
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a2d8f",
          "dark": {
            "backgroundColor": "#0a2d8f"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to capture photos and videos for your posts.",
          "microphonePermission": "This app uses the microphone to record audio and video for your posts.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1857e5a7-1a61-478b-9ed2-41e8cd53b7d3"
      }
    }
  }
}
